# Environment Variables for OctoFit Tracker Frontend

# Codespaces environment variable
# Set this to your actual Codespace name (e.g., "my-codespace")
# The app will use: https://{CODESPACE_NAME}-8000.app.github.dev
# If not set, the app falls back to http://localhost:8000
VITE_CODESPACE_NAME=

# Example for local development with localhost:
# (leave VITE_CODESPACE_NAME empty or unset)

# Example for Codespaces:
# VITE_CODESPACE_NAME=my-octofit-space
